@model IEnumerable<BookManagement.Application.DTOs.BookDto>

@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add New Book</a>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">View Dashboard</a>
</p>

<!-- Search & filter form: a plain GET form so the results (and the
     filter itself) are shareable/bookmarkable via the query string,
     e.g. /Books?searchTerm=tolkien&genre=Fantasy&status=Available -->
<form asp-action="Index" method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-4">
        <label class="form-label">Search (title or author)</label>
        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="e.g. Tolkien" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Genre</label>
        <select name="genre" asp-items="ViewBag.GenreList" class="form-select">
            <option value="">All Genres</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Status</label>
        <select name="status" asp-items="ViewBag.StatusList" class="form-select">
            <option value="">All Statuses</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Author</th>
            <th>Price</th>
            <th>Published Year</th>
            <th>Genre</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var book in Model)
{
        <tr>
            <td>@book.Id</td>
            <td>@book.Title</td>
            <td>@book.Author</td>
            <td>@book.Price.ToString("C")</td>
            <td>@book.PublishedYear</td>
            <td><span class="badge bg-secondary">@book.Genre</span></td>
            <td>
                @{
                    var badgeClass = book.Status switch
                    {
                        BookManagement.Domain.Enums.BookStatus.Available => "bg-success",
                        BookManagement.Domain.Enums.BookStatus.CheckedOut => "bg-warning text-dark",
                        BookManagement.Domain.Enums.BookStatus.Reserved => "bg-info text-dark",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @badgeClass">@book.Status</span>
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
@if (!Model.Any())
{
        <tr>
            <td colspan="8" class="text-center text-muted">No books match your filter.</td>
        </tr>
}
    </tbody>
</table>
