@model IEnumerable<BookManagement.Application.DTOs.BookDto>
@using BookManagement.Domain.Enums

@{
    ViewData["Title"] = "Books";

    // Genre -> placeholder "cover" gradient. No cover images are stored;
    // this just gives each card a distinct, consistent color by genre.
    string GenreColor(Genre genre) => genre switch
    {
        Genre.Fiction => "linear-gradient(135deg,#6a89cc,#4a69bd)",
        Genre.NonFiction => "linear-gradient(135deg,#60a3bc,#3c6382)",
        Genre.SciFi => "linear-gradient(135deg,#8c7ae6,#6c5ce7)",
        Genre.Fantasy => "linear-gradient(135deg,#20bf6b,#0fb9b1)",
        Genre.Biography => "linear-gradient(135deg,#f7b731,#e58e26)",
        Genre.History => "linear-gradient(135deg,#a5b1c2,#4b6584)",
        Genre.Mystery => "linear-gradient(135deg,#4b4b4b,#2c2c54)",
        Genre.Romance => "linear-gradient(135deg,#eb3b5a,#fc5c65)",
        Genre.SelfHelp => "linear-gradient(135deg,#26de81,#20bf6b)",
        Genre.Technology => "linear-gradient(135deg,#45aaf2,#2d98da)",
        _ => "linear-gradient(135deg,#95a5a6,#7f8c8d)"
    };

    string Stars(double rating)
    {
        var full = (int)Math.Round(rating);
        full = Math.Clamp(full, 0, 5);
        return new string('★', full) + new string('☆', 5 - full);
    }
}

<h1>Books</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add New Book</a>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">View Dashboard</a>
</p>

<form asp-action="Index" method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-4">
        <label class="form-label">Search (title or author)</label>
        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="e.g. Tolkien" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Genre</label>
        <select name="genre" asp-items="ViewBag.GenreList" class="form-select">
            <option value="">All Genres</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Status</label>
        <select name="status" asp-items="ViewBag.StatusList" class="form-select">
            <option value="">All Statuses</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

<!-- Grid/List view toggle. Pure client-side: both views render server-side
     with the same filtered data, JS just shows/hides whichever container
     matches the saved preference. -->
<div class="d-flex justify-content-end mb-3">
    <div class="btn-group" role="group">
        <button type="button" id="gridViewBtn" class="btn btn-outline-secondary btn-sm">Grid View</button>
        <button type="button" id="listViewBtn" class="btn btn-outline-secondary btn-sm">List View</button>
    </div>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No books match your filter.</p>
}
else
{
    <!-- GRID VIEW -->
    <div id="gridView" class="row g-3">
        @foreach (var book in Model)
        {
            var statusBadge = book.Status switch
            {
                BookStatus.Available => "bg-success",
                BookStatus.CheckedOut => "bg-warning text-dark",
                BookStatus.Reserved => "bg-info text-dark",
                _ => "bg-secondary"
            };
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100">
                    <div class="book-cover" style="background:@GenreColor(book.Genre)">@book.Title</div>
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title mb-1">@book.Title</h6>
                        <div class="text-muted small mb-2">@book.Author</div>
                        <div class="rating-stars mb-2" title="@book.Rating.ToString("0.0") / 5">@Stars(book.Rating)</div>
                        <div class="mb-2">
                            <span class="badge bg-secondary">@book.Genre</span>
                            <span class="badge @statusBadge">@book.Status</span>
                        </div>
                        <ul class="list-unstyled small text-muted mb-3">
                            <li>@book.Price.ToString("C") &middot; @book.PublishedYear</li>
                            @if (!string.IsNullOrWhiteSpace(book.Publisher))
                            {
                                <li>Publisher: @book.Publisher</li>
                            }
                            @if (!string.IsNullOrWhiteSpace(book.Isbn))
                            {
                                <li>ISBN: @book.Isbn</li>
                            }
                        </ul>
                        <div class="mt-auto d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-info flex-fill">Details</a>
                            <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-warning flex-fill">Edit</a>
                            <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger flex-fill">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- LIST VIEW (original table) -->
    <div id="listView" style="display:none;">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Price</th>
                    <th>Published Year</th>
                    <th>Genre</th>
                    <th>Status</th>
                    <th>Rating</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    var statusBadge = book.Status switch
                    {
                        BookStatus.Available => "bg-success",
                        BookStatus.CheckedOut => "bg-warning text-dark",
                        BookStatus.Reserved => "bg-info text-dark",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td>@book.Id</td>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.Price.ToString("C")</td>
                        <td>@book.PublishedYear</td>
                        <td><span class="badge bg-secondary">@book.Genre</span></td>
                        <td><span class="badge @statusBadge">@book.Status</span></td>
                        <td class="rating-stars">@Stars(book.Rating)</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var gridBtn = document.getElementById('gridViewBtn');
            var listBtn = document.getElementById('listViewBtn');
            var gridView = document.getElementById('gridView');
            var listView = document.getElementById('listView');

            function showGrid() {
                if (gridView) gridView.style.display = '';
                if (listView) listView.style.display = 'none';
                gridBtn.classList.add('btn-secondary');
                gridBtn.classList.remove('btn-outline-secondary');
                listBtn.classList.add('btn-outline-secondary');
                listBtn.classList.remove('btn-secondary');
                localStorage.setItem('bm-books-view', 'grid');
            }

            function showList() {
                if (gridView) gridView.style.display = 'none';
                if (listView) listView.style.display = '';
                listBtn.classList.add('btn-secondary');
                listBtn.classList.remove('btn-outline-secondary');
                gridBtn.classList.add('btn-outline-secondary');
                gridBtn.classList.remove('btn-secondary');
                localStorage.setItem('bm-books-view', 'list');
            }

            gridBtn.addEventListener('click', showGrid);
            listBtn.addEventListener('click', showList);

            // Restore last-used view (defaults to grid).
            if (localStorage.getItem('bm-books-view') === 'list') {
                showList();
            } else {
                showGrid();
            }
        })();
    </script>
}
