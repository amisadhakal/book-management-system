@model BookManagement.Application.DTOs.DashboardDto

@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>

<!-- Summary stat cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-bg-primary h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.TotalBooks</div>
                <div>Total Books</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-success h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.TotalInventoryValue.ToString("C")</div>
                <div>Total Inventory Value</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-info h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.AveragePrice.ToString("C")</div>
                <div>Average Price</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-secondary h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.TotalAuthors</div>
                <div>Distinct Authors</div>
            </div>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Books per Genre</div>
            <div class="card-body"><canvas id="genreChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Books per Status</div>
            <div class="card-body"><canvas id="statusChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Books Published by Year</div>
            <div class="card-body"><canvas id="yearChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Price Distribution</div>
            <div class="card-body"><canvas id="priceChart"></canvas></div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Top Authors</div>
            <ul class="list-group list-group-flush">
                @foreach (var author in Model.TopAuthors)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@author.Author</span>
                        <span class="badge bg-primary rounded-pill">@author.BookCount</span>
                    </li>
                }
                @if (!Model.TopAuthors.Any())
                {
                    <li class="list-group-item text-muted">No data yet.</li>
                }
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Recently Added</div>
            <ul class="list-group list-group-flush">
                @foreach (var book in Model.RecentlyAdded)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@book.Title <small class="text-muted">by @book.Author</small></span>
                        <span class="text-muted">@book.CreatedAt.ToString("MMM d, yyyy")</span>
                    </li>
                }
                @if (!Model.RecentlyAdded.Any())
                {
                    <li class="list-group-item text-muted">No data yet.</li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        // Data is serialized server-side into small JSON arrays so Chart.js
        // (a client-side library) can render without another HTTP round trip.
        const genreLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BooksPerGenre.Select(g => g.Genre)));
        const genreCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BooksPerGenre.Select(g => g.Count)));

        const statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BooksPerStatus.Select(s => s.Status)));
        const statusCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BooksPerStatus.Select(s => s.Count)));

        const yearLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BooksPerPublishedYear.Select(y => y.Year)));
        const yearCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BooksPerPublishedYear.Select(y => y.Count)));

        const priceLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PriceDistribution.Keys));
        const priceCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PriceDistribution.Values));

        new Chart(document.getElementById('genreChart'), {
            type: 'pie',
            data: { labels: genreLabels, datasets: [{ data: genreCounts }] }
        });

        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: { labels: statusLabels, datasets: [{ data: statusCounts }] }
        });

        new Chart(document.getElementById('yearChart'), {
            type: 'bar',
            data: { labels: yearLabels, datasets: [{ label: 'Books', data: yearCounts, backgroundColor: '#0d6efd' }] },
            options: { scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });

        new Chart(document.getElementById('priceChart'), {
            type: 'bar',
            data: { labels: priceLabels, datasets: [{ label: 'Books', data: priceCounts, backgroundColor: '#198754' }] },
            options: { scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });
    </script>
}
